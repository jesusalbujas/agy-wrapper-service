#!/usr/bin/env bash
# ==============================================================================
# ask - CLI client for the agy wrapper API
# Compatible with Zsh, Bash, Dash, and POSIX-compatible shells
# ==============================================================================

CONFIG_URL_FILE="${HOME}/.gemini/antigravity-cli/api_url"
API_BASE=""
if [ -f "$CONFIG_URL_FILE" ]; then
    SAVED_URL=$(cat "$CONFIG_URL_FILE" 2>/dev/null | tr -d '\r\n')
    if [ -n "$SAVED_URL" ]; then
        API_BASE="$SAVED_URL"
    fi
fi
API_BASE="${AGY_API_URL:-${API_BASE:-http://localhost:3000}}"
MODEL=""
LEVEL=""
STREAM=false
CONTINUE=false
SHOW_THINKING=${ASK_SHOW_THINKING:-false}
JSON_OUTPUT=false
RAW_OUTPUT=false
QUERY_PARTS=()

TOKEN_DIR="${HOME}/.gemini/antigravity-cli"
TOKEN_FILE="${TOKEN_DIR}/antigravity-oauth-token"
CONTAINER_NAME="agy-api-wrapper"

handle_set_url() {
    local new_url="$1"
    if [ -z "$new_url" ]; then
        echo -e "${COLOR_RED}[ERROR] You must specify the endpoint URL.${COLOR_RESET}" >&2
        echo "Usage: ask set-url <url>" >&2
        echo "Example: ask set-url http://localhost:3000" >&2
        echo "To restore the local default: ask set-url local" >&2
        exit 1
    fi

    if [ "$new_url" = "local" ] || [ "$new_url" = "default" ] || [ "$new_url" = "reset" ]; then
        rm -f "$CONFIG_URL_FILE"
        echo -e "${COLOR_GREEN}[OK] Endpoint reset to the local default: http://localhost:3000${COLOR_RESET}"
        exit 0
    fi

    new_url="${new_url%/}"
    mkdir -p "$(dirname "$CONFIG_URL_FILE")"
    echo "$new_url" > "$CONFIG_URL_FILE"
    echo -e "${COLOR_GREEN}[OK] Network endpoint configured successfully:${COLOR_RESET}"
    echo -e "    ${COLOR_BOLD}${new_url}${COLOR_RESET}"
    echo ""
    echo -n "Checking server connectivity... "
    if curl -s --connect-timeout 3 "${new_url}/health" >/dev/null 2>&1; then
        echo -e "${COLOR_GREEN}[CONNECTED]${COLOR_RESET}"
        echo -e "The CLI will now use this remote endpoint."
    else
        echo -e "${COLOR_YELLOW}[NOTICE] Could not connect immediately.${COLOR_RESET}"
        echo "Make sure the container is running and reachable at that port or IP."
    fi
    exit 0
}

handle_get_url() {
    echo -e "Current ask endpoint: ${COLOR_CYAN}${COLOR_BOLD}${API_BASE}${COLOR_RESET}"
    if [ -f "$CONFIG_URL_FILE" ]; then
        echo -e "(Saved in: $CONFIG_URL_FILE)"
    else
        echo -e "(Default: http://localhost:3000)"
    fi
    exit 0
}

# Terminal output colors
COLOR_GREEN='\033[0;32m'
COLOR_BLUE='\033[0;34m'
COLOR_YELLOW='\033[1;33m'
COLOR_CYAN='\033[0;36m'
COLOR_RED='\033[0;31m'
COLOR_BOLD='\033[1m'
COLOR_RESET='\033[0m'

get_token_info() {
    if [ ! -f "$TOKEN_FILE" ]; then
        return 1
    fi
    python3 -c '
import json, base64, sys

token_file = sys.argv[1]
try:
    with open(token_file) as f:
        data = json.load(f)
    
    id_token = data.get("id_token", "")
    email = "Unknown"
    name = "Unknown"
    if id_token and "." in id_token:
        parts = id_token.split(".")
        if len(parts) >= 2:
            payload = parts[1] + "=" * ((4 - len(parts[1]) % 4) % 4)
            claims = json.loads(base64.urlsafe_b64decode(payload))
            email = claims.get("email", "Unknown")
            name = claims.get("name", "Unknown")
    
    expiry_str = data.get("token", {}).get("expiry", "No expiration date")
    method = data.get("auth_method", "consumer")
    has_refresh = "refresh_token" in data.get("token", {})
    
    print(f"NAME={name}")
    print(f"EMAIL={email}")
    print(f"EXPIRY={expiry_str}")
    print(f"METHOD={method}")
    print(f"HAS_REFRESH={has_refresh}")
except Exception:
    sys.exit(1)
' "$TOKEN_FILE" 2>/dev/null
}

handle_auth_status() {
    echo -e "${COLOR_BLUE}==========================================================${COLOR_RESET}"
    echo -e "${COLOR_BLUE}     Antigravity CLI - Authentication Status            ${COLOR_RESET}"
    echo -e "${COLOR_BLUE}==========================================================${COLOR_RESET}"
    
    if [ ! -f "$TOKEN_FILE" ]; then
        echo -e "${COLOR_YELLOW}[!] No active token found at:${COLOR_RESET}"
        echo -e "    $TOKEN_FILE"
        echo ""
        echo -e "Run ${COLOR_BOLD}ask login${COLOR_RESET} to sign in with your Google account."
        exit 1
    fi

    local info
    info=$(get_token_info)
    if [ $? -ne 0 ] || [ -z "$info" ]; then
        echo -e "${COLOR_RED}[ERROR] The token file is corrupted or is not valid JSON.${COLOR_RESET}"
        echo -e "Run ${COLOR_BOLD}ask login${COLOR_RESET} to create new credentials."
        exit 1
    fi

    local token_name token_email token_expiry token_method token_refresh
    token_name=$(echo "$info" | grep '^NAME=' | cut -d= -f2-)
    token_email=$(echo "$info" | grep '^EMAIL=' | cut -d= -f2-)
    token_expiry=$(echo "$info" | grep '^EXPIRY=' | cut -d= -f2-)
    token_method=$(echo "$info" | grep '^METHOD=' | cut -d= -f2-)
    token_refresh=$(echo "$info" | grep '^HAS_REFRESH=' | cut -d= -f2-)

    echo -e "  ${COLOR_BOLD}File:${COLOR_RESET}           $TOKEN_FILE"
    echo -e "  ${COLOR_BOLD}User:${COLOR_RESET}           ${COLOR_GREEN}${token_name}${COLOR_RESET}"
    echo -e "  ${COLOR_BOLD}Email:${COLOR_RESET}            ${COLOR_CYAN}${token_email}${COLOR_RESET}"
    echo -e "  ${COLOR_BOLD}Method:${COLOR_RESET}            $token_method"
    echo -e "  ${COLOR_BOLD}Expires:${COLOR_RESET}            $token_expiry"
    echo -e "  ${COLOR_BOLD}Refresh Token:${COLOR_RESET}    $([ "$token_refresh" = "True" ] && echo -e "${COLOR_GREEN}Yes (automatic refresh enabled)${COLOR_RESET}" || echo -e "${COLOR_RED}No${COLOR_RESET}")"
    echo ""

    if command -v docker >/dev/null 2>&1; then
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
            echo -e "  ${COLOR_BOLD}Local service:${COLOR_RESET}    ${COLOR_GREEN}● Running (${CONTAINER_NAME})${COLOR_RESET}"
        elif docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
            echo -e "  ${COLOR_BOLD}Local service:${COLOR_RESET}    ${COLOR_YELLOW}○ Stopped (${CONTAINER_NAME})${COLOR_RESET}"
        fi
    fi
    echo ""
    exit 0
}

handle_auth_sync() {
    local target="$1"
    local remote_host=""

    if [ -z "$target" ]; then
        echo "Usage: ask auth sync <user@host>" >&2
        exit 1
    fi
    remote_host="$target"

    echo -e "${COLOR_BLUE}==========================================================${COLOR_RESET}"
    echo -e "${COLOR_BLUE}    Authentication sync -> ${remote_host}     ${COLOR_RESET}"
    echo -e "${COLOR_BLUE}==========================================================${COLOR_RESET}"

    if [ ! -f "$TOKEN_FILE" ] || [ ! -s "$TOKEN_FILE" ]; then
        echo -e "${COLOR_RED}[ERROR] No local session token is available to sync.${COLOR_RESET}"
        echo -e "Run this first: ${COLOR_BOLD}ask login${COLOR_RESET}"
        exit 1
    fi

    local info
    info=$(get_token_info 2>/dev/null)
    local sync_email
    sync_email=$(echo "$info" | grep '^EMAIL=' | cut -d= -f2-)
    echo -e "-> Sending credentials for: ${COLOR_CYAN}${sync_email}${COLOR_RESET}"

    ssh -o ConnectTimeout=5 -o BatchMode=yes "${remote_host}" "mkdir -p ~/.gemini/antigravity-cli" 2>/dev/null
    if [ $? -ne 0 ]; then
        echo -e "${COLOR_RED}[ERROR] Could not connect to ${remote_host} over SSH.${COLOR_RESET}"
        echo -e "Check your connection and SSH keys."
        exit 1
    fi

    scp -q -o ConnectTimeout=5 "$TOKEN_FILE" "${remote_host}:~/.gemini/antigravity-cli/antigravity-oauth-token"
    if [ $? -ne 0 ]; then
        echo -e "${COLOR_RED}[ERROR] Failed to copy the token to ${remote_host}.${COLOR_RESET}"
        exit 1
    fi
    echo -e "${COLOR_GREEN}[OK] Token copied to ${remote_host}:~/.gemini/antigravity-cli/antigravity-oauth-token${COLOR_RESET}"

    echo -e "-> Restarting the API service on ${remote_host}..."
    ssh -o ConnectTimeout=5 -o BatchMode=yes "${remote_host}" "docker restart ${CONTAINER_NAME} 2>/dev/null || true" >/dev/null 2>&1
    echo -e "${COLOR_GREEN}${COLOR_BOLD}[SUCCESS] Session synced and active on ${remote_host}.${COLOR_RESET}"
    echo ""
    exit 0
}

handle_login() {
    echo -e "${COLOR_BLUE}==========================================================${COLOR_RESET}"
    echo -e "${COLOR_BLUE}         Antigravity CLI - Google Sign-In        ${COLOR_RESET}"
    echo -e "${COLOR_BLUE}==========================================================${COLOR_RESET}"

    if [ ! -t 0 ]; then
        echo -e "${COLOR_RED}[ERROR] Run 'ask login' from an interactive terminal.${COLOR_RESET}"
        exit 1
    fi

    if [ -f "$TOKEN_FILE" ]; then
        local current_info
        current_info=$(get_token_info 2>/dev/null)
        local cur_email cur_name
        cur_email=$(echo "$current_info" | grep '^EMAIL=' | cut -d= -f2-)
        cur_name=$(echo "$current_info" | grep '^NAME=' | cut -d= -f2-)
        
        if [ -n "$cur_email" ] && [ "$cur_email" != "Unknown" ]; then
            echo -e "${COLOR_YELLOW}[i] An active session already exists for:${COLOR_RESET}"
            echo -e "    ${COLOR_BOLD}${cur_name} <${cur_email}>${COLOR_RESET}"
            echo ""
            read -r -p "Sign in again or switch accounts? [y/N]: " confirm
            if [[ ! "$confirm" =~ ^[yY]$ ]]; then
                echo -e "${COLOR_GREEN}[OK] Keeping the current session.${COLOR_RESET}"
                exit 0
            fi
            echo ""
        fi
        cp -f "$TOKEN_FILE" "${TOKEN_FILE}.bak"
        rm -f "$TOKEN_FILE"
    fi

    echo -e "${COLOR_CYAN}-> Starting interactive Google authentication...${COLOR_RESET}"
    echo -e "${COLOR_YELLOW}Instructions:${COLOR_RESET}"
    echo -e "  1. Open the link shown below in your browser."
    echo -e "  2. Sign in to Google and authorize the application."
    echo -e "  3. Copy the verification code and paste it here."
    echo -e "${COLOR_BLUE}----------------------------------------------------------${COLOR_RESET}"
    echo ""

    if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
        docker exec -it "${CONTAINER_NAME}" /root/.local/bin/agy -p "auth-session-init" || true
    elif command -v agy >/dev/null 2>&1; then
        DBUS_SESSION_BUS_ADDRESS="" agy -p "auth-session-init" || true
    else
        echo -e "${COLOR_RED}[ERROR] Could not find the 'agy' executable or the '${CONTAINER_NAME}' Docker container.${COLOR_RESET}"
        if [ -f "${TOKEN_FILE}.bak" ]; then
            mv -f "${TOKEN_FILE}.bak" "$TOKEN_FILE"
        fi
        exit 1
    fi

    echo ""
    echo -e "${COLOR_BLUE}----------------------------------------------------------${COLOR_RESET}"

    if [ -f "$TOKEN_FILE" ] && [ -s "$TOKEN_FILE" ]; then
        local new_info
        new_info=$(get_token_info 2>/dev/null)
        local new_email new_name
        new_email=$(echo "$new_info" | grep '^EMAIL=' | cut -d= -f2-)
        new_name=$(echo "$new_info" | grep '^NAME=' | cut -d= -f2-)

        echo -e "${COLOR_GREEN}${COLOR_BOLD}[SUCCESS] Sign-in completed successfully.${COLOR_RESET}"
        if [ -n "$new_email" ]; then
            echo -e "Signed in as: ${COLOR_CYAN}${new_name} <${new_email}>${COLOR_RESET}"
        fi

        if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
            echo -e "-> Restarting the local API service (${CONTAINER_NAME})..."
            docker restart "${CONTAINER_NAME}" >/dev/null 2>&1 || true
            echo -e "${COLOR_GREEN}[OK] Local API service restarted.${COLOR_RESET}"
        fi

        exit 0
    else
        echo -e "${COLOR_RED}[!] Sign-in did not complete.${COLOR_RESET}"
        if [ -f "${TOKEN_FILE}.bak" ]; then
            echo -e "-> Restoring the previous credentials..."
            mv -f "${TOKEN_FILE}.bak" "$TOKEN_FILE"
            echo -e "${COLOR_YELLOW}[i] Previous session restored.${COLOR_RESET}"
        fi
        exit 1
    fi
}

handle_logout() {
    echo -e "${COLOR_BLUE}==========================================================${COLOR_RESET}"
    echo -e "${COLOR_BLUE}             Antigravity CLI - Sign Out              ${COLOR_RESET}"
    echo -e "${COLOR_BLUE}==========================================================${COLOR_RESET}"

    if [ ! -f "$TOKEN_FILE" ]; then
        echo -e "${COLOR_YELLOW}[i] No active session on this machine.${COLOR_RESET}"
        exit 0
    fi

    local info
    info=$(get_token_info 2>/dev/null)
    local cur_email
    cur_email=$(echo "$info" | grep '^EMAIL=' | cut -d= -f2-)

    read -r -p "Sign out from '${cur_email}'? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[yY]$ ]]; then
        echo -e "${COLOR_GREEN}[OK] Operation canceled.${COLOR_RESET}"
        exit 0
    fi

    mv -f "$TOKEN_FILE" "${TOKEN_FILE}.bak"
    echo -e "${COLOR_GREEN}[OK] Signed out successfully (backup saved as .bak).${COLOR_RESET}"

    if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
        echo -e "-> Restarting the local service..."
        docker restart "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    fi
    exit 0
}

handle_auth() {
    local subcmd="$1"
    shift 2>/dev/null || true
    case "$subcmd" in
        status|"")
            handle_auth_status
            ;;
        sync)
            handle_auth_sync "$1"
            ;;
        *)
            echo "Unknown subcommand: ask auth $subcmd" >&2
            echo "Usage: ask auth [status|sync <user@host>]" >&2
            exit 1
            ;;
    esac
}

show_help() {
    cat <<EOF
Usage: ask [options] "your query..."
     or: echo "text" | ask [options] "instruction"
     or: ask <command>

Commands:
  login                  Sign in to your Google account using OAuth
  auth [status]          Show the active Google/Antigravity session status
  auth sync <user@host> Sync the token to a remote server over SSH
  set-url <url>          Set the API server URL (for example, http://localhost:3000)
  url                    Show the currently configured server URL
  logout                 Sign out of Google/Antigravity
  models                 List models and effort levels available through the API

Options:
  -c, --continue         Continue the most recent conversation (preserve context)
  -t, --thinking         Show model thinking in the stream
  -m, --model <model>   Model to use (for example, claude-sonnet-4-6)
  -l, --level <level>    Reasoning effort (low, medium, high)
  -s, --stream           Stream the response as it is generated
  -j, --json             Return the response as JSON
  -r, --raw              Show raw text without formatting or animation
  -u, --url <url>        Base API URL (default: http://localhost:3000)
  --models               List models and effort levels available through the API
  -h, --help             Show this help

Examples:
  ask login
  ask auth status
  ask auth sync user@server
  ask tell me a programmer joke
  ask -t "what is the best way to structure a web application?"
  ask -s explain microservices in three points
  ask -c "now explain point 2 with a Node.js example"
  ask -m claude-sonnet-4-6 -l high "What is an ACID transaction?"
  cat error.log | ask "Explain why this failed"
  git diff | ask "Write a conventional commit message"
EOF
    exit 0
}

list_models() {
    curl -s "${API_BASE}/models" | jq . 2>/dev/null || curl -s "${API_BASE}/models"
    echo ""
    exit 0
}

# Main commands
case "$1" in
    login)
        shift
        handle_login "$@"
        ;;
    auth)
        shift
        handle_auth "$@"
        ;;
    set-url|seturl)
        shift
        handle_set_url "$@"
        ;;
    url|get-url|geturl)
        handle_get_url
        ;;
    logout)
        shift
        handle_logout "$@"
        ;;
    models)
        shift
        list_models
        ;;
esac

# Parse standard arguments and options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        --models)
            list_models
            ;;
        -c|--continue)
            CONTINUE=true
            shift
            ;;
        -t|--thinking)
            SHOW_THINKING=true
            if [ "$JSON_OUTPUT" != true ]; then
                STREAM=true
            fi
            shift
            ;;
        -m|--model)
            MODEL="$2"
            shift 2
            ;;
        -l|--level)
            LEVEL="$2"
            shift 2
            ;;
        -s|--stream)
            STREAM=true
            shift
            ;;
        -j|--json)
            JSON_OUTPUT=true
            STREAM=false
            shift
            ;;
        -r|--raw)
            RAW_OUTPUT=true
            shift
            ;;
        -u|--url)
            API_BASE="$2"
            shift 2
            ;;
        *)
            QUERY_PARTS+=("$1")
            shift
            ;;
    esac
done

# Read piped input from stdin, when available
PIPE_INPUT=""
if [ ! -t 0 ]; then
    # Avoid blocking in non-interactive environments when the pipe is empty
    if read -t 0.1 -r first_line; then
        rest_lines=$(cat)
        if [ -n "$rest_lines" ]; then
            PIPE_INPUT="${first_line}
${rest_lines}"
        else
            PIPE_INPUT="${first_line}"
        fi
    fi
fi

QUERY="${QUERY_PARTS[*]}"

if [ -n "$PIPE_INPUT" ]; then
    if [ -n "$QUERY" ]; then
        QUERY="${QUERY}

${PIPE_INPUT}"
    else
        QUERY="$PIPE_INPUT"
    fi
fi

if [ -z "$QUERY" ]; then
    echo "Error: Enter a query. Example: ask tell me a joke" >&2
    echo "Run 'ask --help' to see available options." >&2
    exit 1
fi

# Spinner and Markdown-to-ANSI output formatter
process_output() {
    # Skip formatting for non-interactive output and JSON/raw modes
    if [ ! -t 1 ] || [ "$JSON_OUTPUT" = true ] || [ "$RAW_OUTPUT" = true ]; then
        cat
        return
    fi

    if command -v python3 >/dev/null 2>&1; then
        python3 -u -c '
import sys, re, time, threading

stop_spinner = False
spinner_cleared = False
spinner_lock = threading.Lock()

def spin():
    frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    i = 0
    sys.stderr.write("\033[?25l")
    while True:
        with spinner_lock:
            if stop_spinner:
                break
            sys.stderr.write(f"\r\033[36m{frames[i % len(frames)]}\033[0m \033[2mThinking...\033[0m")
            sys.stderr.flush()
        i += 1
        time.sleep(0.08)

t = threading.Thread(target=spin, daemon=True)
t.start()

def clear_spinner():
    global stop_spinner, spinner_cleared
    with spinner_lock:
        if not spinner_cleared:
            stop_spinner = True
            spinner_cleared = True
            sys.stderr.write("\r\033[2K\033[?25h")
            sys.stderr.flush()

try:
    in_thinking = False
    for line in sys.stdin:
        clear_spinner()

        # Detect the beginning of a thinking block
        if " [Thoughts]:" in line:
            in_thinking = True
            sys.stdout.write("\n\033[1;35m Thoughts:\033[0m\n")
            sys.stdout.flush()
            continue
        elif in_thinking:
            # End of the thinking block
            if line.strip() == "" or line.startswith("⚡ [Action:") or line.startswith("---"):
                in_thinking = False
                sys.stdout.write("\033[35m  └──────────────────────────────────────────────────────────\033[0m\n\n")
                sys.stdout.flush()
                if line.strip() == "":
                    continue
            else:
                sys.stdout.write(f"\033[35m  │\033[0m \033[97m{line.rstrip()}\033[0m\n")
                sys.stdout.flush()
                continue

        # Format tool actions
        if line.startswith("⚡ [Action:"):
            sys.stdout.write(f"\033[1;33m{line.rstrip()}\033[0m\n")
            sys.stdout.flush()
            continue

        # Format Markdown as ANSI
        line = re.sub(r"\*\*([^*]+)\*\*", "\033[1m\\1\033[0m", line)
        line = re.sub(r"`([^`]+)`", "\033[36m\\1\033[0m", line)
        line = re.sub(r"^(#{1,6}) (.*)", "\033[1;34m\\2\033[0m", line)
        line = re.sub(r"^[ \t]*[-*] ", "  \033[32m•\033[0m ", line)
        sys.stdout.write(line)
        sys.stdout.flush()

    if in_thinking:
        sys.stdout.write("\033[35m  └──────────────────────────────────────────────────────────\033[0m\n\n")
        sys.stdout.flush()
finally:
    clear_spinner()
'
    else
        sed -u -E \
            -e 's/\*\*([^*]+)\*\*/'$'\033''[1m\1'$'\033''[0m/g' \
            -e 's/`([^`]+)`/'$'\033''[36m\1'$'\033''[0m/g' \
            -e 's/^(#{1,6}) (.*)/'$'\033''[1;34m\2'$'\033''[0m/g' \
            -e 's/^[ \t]*[-*] /  '$'\033''[32m•'$'\033''[0m /g'
    fi
}

# Build the JSON payload with jq or Python 3
PAYLOAD=""
if command -v jq >/dev/null 2>&1; then
    PAYLOAD=$(jq -n \
        --arg q "$QUERY" \
        --arg m "$MODEL" \
        --arg l "$LEVEL" \
        --argjson s "$STREAM" \
        --argjson c "$CONTINUE" \
        --argjson t "$SHOW_THINKING" \
        --argjson j "$JSON_OUTPUT" \
        '{query: $q} + (if $m != "" then {model: $m} else {} end) + (if $l != "" then {level: $l} else {} end) + (if $s then {stream: true} else {} end) + (if $c then {continue: true} else {} end) + (if $t then {thinking: true} else {} end) + (if $j then {json: true} else {} end)')
else
    PAYLOAD=$(python3 -c 'import json, sys; print(json.dumps({"query": sys.argv[1], "model": sys.argv[2] or None, "level": sys.argv[3] or None, "stream": sys.argv[4] == "true", "continue": sys.argv[5] == "true", "thinking": sys.argv[6] == "true", "json": sys.argv[7] == "true"}))' "$QUERY" "$MODEL" "$LEVEL" "$STREAM" "$CONTINUE" "$SHOW_THINKING" "$JSON_OUTPUT")
fi

ENDPOINT="${API_BASE}/ask"

if [ "$STREAM" = true ]; then
    curl -N -s -X POST "$ENDPOINT" \
        -H "Content-Type: application/json" \
        -d "$PAYLOAD" | process_output
else
    curl -s -X POST "$ENDPOINT" \
        -H "Content-Type: application/json" \
        -d "$PAYLOAD" | process_output
fi
echo ""
