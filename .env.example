# ==============================================================================
# Environment Configuration - Antigravity CLI API Wrapper (Example Template)
# ==============================================================================

# Port used by the API inside the container
PORT=3000

# Default model for queries; any model supported by agy may be used
DEFAULT_MODEL=gemini-3.8-flash

# Default reasoning effort: low | medium | high
DEFAULT_LEVEL=medium

# Temporary storage directory for files uploaded to /ask-file
UPLOAD_DIR=/app/uploads

# Path to the agy executable inside the container
AGY_PATH=/root/.local/bin/agy
