# ==============================================================================
# Environment Configuration - Antigravity CLI API Wrapper (Example Template)
# ==============================================================================

# Port used by the API inside the container
PORT=3000

# Default model for queries; any model supported by agy may be used
DEFAULT_MODEL=gemini-3.8-flash

# Default reasoning effort: low | medium | high
DEFAULT_LEVEL=medium

# Default workspace directory passed to agy when not specified per request
WORKSPACE_DIR=/app

# Temporary storage directory for files uploaded to /ask-file
UPLOAD_DIR=/app/uploads

# Path to the agy executable inside the container
AGY_PATH=/usr/local/bin/agy

# Host user and unlocked D-Bus session socket used by the Antigravity keyring
AGY_UID=1000
AGY_GID=1000
AGY_DBUS_SOCKET=/run/user/1000/bus

# Host directory used to persist uploaded files
AGY_UPLOADS_HOST_DIR=../uploads

# Maximum number of warm Antigravity conversations kept by the API
AGY_MAX_SESSIONS=32

# Close an idle Antigravity conversation after this duration
AGY_SESSION_IDLE_TIMEOUT=15m

# Optional API key (if set, all endpoints except /health require Bearer or X-API-Key)
API_KEY=

# Optional comma-separated CORS origins (e.g. http://localhost:5173 or *)
CORS_ORIGINS=
